# kb-admin configuration (loaded by pydantic-settings)
# Copy this file to .env and fill in real values for local dev.

# ===== App =====
APP_NAME=KBMS Admin
APP_PORT=8002
APP_HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# ===== Postgres =====
# async DSN (used by SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://kbms:kbms@localhost:5432/kbms
# sync DSN (used by Alembic migrations)
DATABASE_SYNC_URL=postgresql+psycopg2://kbms:kbms@localhost:5432/kbms

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAY=14

# ===== Initial superuser (created by scripts/create_superuser.py if absent) =====
INITIAL_SUPERUSER_USERNAME=admin
INITIAL_SUPERUSER_PASSWORD=admin123
INITIAL_SUPERUSER_EMAIL=admin@example.com

# ===== RAG engine integration =====
# admin calls the existing RAG upload endpoint on behalf of authenticated users.
RAG_BASE_URL=http://localhost:8000

# ===== CORS =====
# Comma-separated list of origins, or "*" to allow all (dev only).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8002